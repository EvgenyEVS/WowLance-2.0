DATABASE_URL=postgresql+psycopg://wowlance:wowlance@127.0.0.1:5433/wowlance
APP_ENV=local

# --- C8 auth (Keycloak JWT) ---
# true  -> dev/tests: /api/v1/* open, no Bearer required (default, pytest uses it)
# false -> strict: 401 without a valid Bearer JWT
AUTH_DISABLED=true
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/wowlance
KEYCLOAK_AUDIENCE=wowlance-api
# KEYCLOAK_JWKS_URL=http://127.0.0.1:8080/realms/wowlance/protocol/openid-connect/certs
# Dev-only: stub JWKS endpoint + POST /auth/stub-token (never enable in prod)
AUTH_STUB_JWKS=false
