DATABASE_URL=postgresql+psycopg://wowlance:wowlance@127.0.0.1:5433/wowlance
# Pytest uses a separate DB (default: same host/user, database wowlance_test).
# TEST_DATABASE_URL=postgresql+psycopg://wowlance:wowlance@127.0.0.1:5433/wowlance_test
APP_ENV=local
AUTH_DISABLED=true
# AUTH_DISABLED=false
# AUTH_STUB_JWKS=true
# KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/wowlance
# KEYCLOAK_AUDIENCE=wowlance-api

# C21: internal service-token guard on /internal/v1/* (stub, без Keycloak / Gateway).
# true — dev/tests, internal routes открыты (по умолчанию).
INTERNAL_AUTH_DISABLED=true
# INTERNAL_AUTH_DISABLED=false
# INTERNAL_SERVICE_TOKEN=change-me-in-prod

# C27: local room RBAC (founder/teamlead/member). true = no 403 from roles (demo/pytest).
ROOM_RBAC_DISABLED=true
# ROOM_RBAC_DISABLED=false
